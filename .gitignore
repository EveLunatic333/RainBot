# ==========================================
# RUST BUILD ARTIFACTS
# ==========================================
# Generated by Cargo
# Contains compiled files and heavy executables
/target/
# Stray CARGO_TARGET_DIR created with a malformed path on Windows
/C*Users*/

# ==========================================
# SECURITY & CREDENTIALS (VAULT PROTOCOL)
# ==========================================
# Environment variables and local configurations
.env
.env.*
!.env.example

# Live configuration holds server-specific IDs and infrastructure details.
# config.example.json is the tracked template.
/config.json
!/config.example.json

# Assistant / tooling metadata (may contain credentials and machine paths)
/.codebuddy/
/.serena/

# ==========================================
# DEPLOYMENT ARTIFACTS
# ==========================================
# Pre-compiled Linux ELF binary built for the VPS target
/rain-bot

# ==========================================
# RUNTIME DATA (contains user PII)
# ==========================================
# Folder structure is preserved via .gitkeep placeholders.
/CACHE
/logs/*
!/logs/.gitkeep
/save/*
!/save/.gitkeep
/static/huntercards/*
!/static/huntercards/.gitkeep

# ==========================================
# IDE & OS METADATA
# ==========================================
.vscode/
.idea/
.DS_Store

# ==========================================
# INTERNAL DOCUMENTATION (kept locally, not published)
# ==========================================
# Analysis reports, backlog, changelog, and audit notes stay on the
# maintainer's machine. README.md is intentionally NOT ignored.
/BACKLOG.md
/CHANGELOG.md
/Laporan_Analisis*.md
/Party_Bug_Report_and_Fix_Plan.md
/RequestToJoin_Plan.md
/reports/
