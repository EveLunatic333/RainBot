# Rain-bot v2.1 — Environment Variables
#
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must NEVER be committed.

# ------------------------------------------
# REQUIRED — the bot cannot start without these
# ------------------------------------------

# Discord bot token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL password for the `erupe` database.
# Host / user / port / database name live in config.json.
POSTGRES_PASSWORD=your_db_password_here

# ------------------------------------------
# CONDITIONALLY REQUIRED — only when the matching feature is enabled
# ------------------------------------------

# OpenAI API token.
# Required when "gpt" is true under commands_toggle in config.json.
CHATGPT_TOKEN=your_chatgpt_token_here

# Sightengine credentials for image moderation.
# Required when discord.sightengine_enabled is true in config.json, and also
# used by /huntercard edit. When unset, moderation is skipped with a warning
# instead of crashing the bot.
SIGHTENGINE_API_USER=your_sightengine_user_id
SIGHTENGINE_API_SECRET=your_sightengine_secret

# ------------------------------------------
# OPTIONAL
# ------------------------------------------

# Log level filter (tracing). Defaults to "info,sqlx=warn" when unset.
# RUST_LOG=info,sqlx=warn
