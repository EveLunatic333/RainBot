# Rain-bot v2.1 — Environment Variables
#
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must NEVER be committed.

# ------------------------------------------
# REQUIRED — the bot cannot start without these
# ------------------------------------------

# Discord bot token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL password for the `erupe` database.
POSTGRES_PASSWORD=your_db_password_here

# ------------------------------------------
# DATABASE CONNECTION — kept here, not in config.json
# ------------------------------------------
# These used to live under "postgress" in config.json, which disclosed the host,
# port, database name and user to anyone who could read that file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erupe
POSTGRES_USER=postgres

# Convenience alternative: set DATABASE_URL and it wins over the four variables
# above (POSTGRES_PASSWORD is still taken from this file if the URL omits it).
# DATABASE_URL=postgres://user:password@host:5432/erupe

# ------------------------------------------
# CONDITIONALLY REQUIRED — only when the matching feature is enabled
# ------------------------------------------

# ------------------------------------------
# OPTIONAL
# ------------------------------------------

# Log level filter (tracing). Defaults to "info,sqlx=warn" when unset.
# RUST_LOG=info,sqlx=warn
